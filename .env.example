# Copie para .env e ajuste. NUNCA versione o .env real.
PORT=3000

# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# (mínimo de 32 caracteres; o servidor não sobe com valor menor)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-64-caracteres-ou-mais

# Usado apenas por: npm run create:staff
STAFF_EMAIL=admin@academia.com
STAFF_PASSWORD=TroqueEstaSenha123
STAFF_ROLE=admin

# Cache da listagem de treinos (segundos; 0 desativa)
CACHE_TTL_SECONDS=30

# Limites de requisição
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Origens permitidas por CORS (separadas por vírgula). Vazio = só mesmo domínio.
# CORS_ORIGIN=http://localhost:5173

# 1 quando há proxy reverso (Nginx) na frente; vazio quando roda direto
# TRUST_PROXY=1

# Caminho do banco (padrão: ./database/gym.sqlite)
# DB_PATH=./database/gym.sqlite
